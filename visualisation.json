{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "transparent",
  "description": "Map of Globe at Night observations coloured by limiting magnitude",
  "width": 620,
  "height": 460,
  "padding": {
    "left": 5,
    "right": 20,
    "top": 10,
    "bottom": 5
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/GaN2025.json",
    "format": {
      "type": "json"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.Latitude)",
      "as": "lat"
    },
    {
      "calculate": "toNumber(datum.Longitude)",
      "as": "lon"
    },
    {
      "calculate": "toNumber(datum.LimitingMag)",
      "as": "limiting_mag"
    },
    {
      "filter": "isValid(datum.lat) && isFinite(datum.lat)"
    },
    {
      "filter": "isValid(datum.lon) && isFinite(datum.lon)"
    },
    {
      "filter": "isValid(datum.limiting_mag) && isFinite(datum.limiting_mag)"
    },
    {
      "filter": "datum.lat >= -60 && datum.lat <= 80"
    },
    {
      "filter": "datum.lon >= -170 && datum.lon <= 180"
    },
    {
      "filter": "datum.limiting_mag >= 0 && datum.limiting_mag <= 7"
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [10, 20],
    "scale": 105
  },
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name != 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#3b3d45",
        "stroke": "#686b75",
        "strokeWidth": 0.45
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 42,
        "opacity": 0.8,
        "stroke": "#15161a",
        "strokeWidth": 0.25
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "limiting_mag",
          "type": "quantitative",
          "title": "Limiting magnitude",
          "scale": {
            "scheme": "plasma",
            "domain": [0, 7]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "gradientThickness": 10,
            "titleColor": "#eeeeee",
            "labelColor": "#dddddd",
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {
            "field": "ID",
            "type": "nominal",
            "title": "Observation ID"
          },
          {
            "field": "LocalDate",
            "type": "nominal",
            "title": "Date"
          },
          {
            "field": "LocalTime",
            "type": "nominal",
            "title": "Time"
          },
          {
            "field": "limiting_mag",
            "type": "quantitative",
            "title": "Limiting magnitude"
          },
          {
            "field": "Constellation",
            "type": "nominal",
            "title": "Constellation"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "titleColor": "#eeeeee",
      "labelColor": "#dddddd"
    }
  }
}
