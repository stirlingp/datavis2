{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "background": "#bdbdc0",

  "description": "Map of GAN observations colored by Limiting Magnitude",

  "width": 700,
  "height": 550,

  "padding": 3,

  "autosize": {
    "type": "fit",
    "contains": "padding"
  },

  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/GaN2025.json",
    "format": {"type": "json"}
  },

  "transform": [
    {"filter": "isValid(datum.LimitingMag)"},
    {"filter": "datum.Latitude >= -60 && datum.Latitude <= 80"},
    {"filter": "datum.Longitude >= -170 && datum.Longitude <= 180"}
  ],

  "projection": {
    "type": "mercator",
    "center": [10, 20],
    "scale": 115
  },

  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "filter": "datum.properties.name != 'Antarctica'"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#e0e0e0",
        "stroke": "white"
      }
    },

    {
      "mark": {
        "type": "circle",
        "size": 80,
        "opacity": 0.85
      },

      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "color": {
          "field": "LimitingMag",
          "type": "quantitative",

          "scale": {
            "scheme": "plasma",
            "domain": [0, 7]
          },

          "legend": null
        },

        "tooltip": [
          {"field": "ID"},
          {"field": "LocalDate"},
          {"field": "LocalTime"},
          {"field": "LimitingMag"},
          {"field": "Constellation"}


        ]
      }
    }
  ]
}
