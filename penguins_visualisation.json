{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"right": 160},
  "width": 1000,
  "height": 520,
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/nightly_penguin_counts.csv",
    "format": {"type": "csv"}
  },
  "params": [
    {
      "name": "arrivalChoice",
      "value": "First",
      "bind": {
        "element": "#penguin-arrival-control",
        "input": "select",
        "options": ["First", "Cross"],
        "labels": ["First arrival at beach", "First cross beach"],
        "name": "Arrival field: "
      }
    }
  ],
  "transform": [
    {"calculate": "toNumber(datum.CloudCover)", "as": "CloudCoverNum"},
    {"calculate": "timeParse(datum.Date, '%d/%m/%Y')", "as": "Date_parsed"},
    {"calculate": "datum.Firsttimeatbeach == null ? null : toString(datum.Firsttimeatbeach)", "as": "FirstHHMM_raw"},
    {"calculate": "datum.Firstcrossbeach == null ? null : toString(datum.Firstcrossbeach)", "as": "CrossHHMM_raw"},
    {"calculate": "datum.FirstHHMM_raw == null ? null : (length(datum.FirstHHMM_raw) === 3 ? '0' + datum.FirstHHMM_raw : datum.FirstHHMM_raw)", "as": "FirstHHMM_pad"},
    {"calculate": "datum.CrossHHMM_raw == null ? null : (length(datum.CrossHHMM_raw) === 3 ? '0' + datum.CrossHHMM_raw : datum.CrossHHMM_raw)", "as": "CrossHHMM_pad"},
    {"calculate": "datum.FirstHHMM_pad == null ? null : (toNumber(substring(datum.FirstHHMM_pad,0,2)) * 60 + toNumber(substring(datum.FirstHHMM_pad,2,4)))", "as": "FirstHHMM_Minutes"},
    {"calculate": "datum.CrossHHMM_pad == null ? null : (toNumber(substring(datum.CrossHHMM_pad,0,2)) * 60 + toNumber(substring(datum.CrossHHMM_pad,2,4)))", "as": "CrossHHMM_Minutes"},
    {"calculate": "datum['first time at beach'] == null ? null : trim(datum['first time at beach'])", "as": "FirstHM_raw"},
    {"calculate": "datum['first cross time'] == null ? null : trim(datum['first cross time'])", "as": "CrossHM_raw"},
    {"calculate": "datum.sunset_time == null ? null : trim(datum.sunset_time)", "as": "SunsetHM_raw"},
    {"calculate": "datum.FirstHM_raw == null ? null : (indexof(datum.FirstHM_raw, ':') >= 0 ? toNumber(substring(datum.FirstHM_raw,0,indexof(datum.FirstHM_raw,':'))) : null)", "as": "FirstHM_hour"},
    {"calculate": "datum.FirstHM_raw == null ? null : (indexof(datum.FirstHM_raw, ':') >= 0 ? toNumber(substring(datum.FirstHM_raw,indexof(datum.FirstHM_raw,':')+1,indexof(datum.FirstHM_raw,' '))) : null)", "as": "FirstHM_min"},
    {"calculate": "datum.CrossHM_raw == null ? null : (indexof(datum.CrossHM_raw, ':') >= 0 ? toNumber(substring(datum.CrossHM_raw,0,indexof(datum.CrossHM_raw,':'))) : null)", "as": "CrossHM_hour"},
    {"calculate": "datum.CrossHM_raw == null ? null : (indexof(datum.CrossHM_raw, ':') >= 0 ? toNumber(substring(datum.CrossHM_raw,indexof(datum.CrossHM_raw,':')+1,indexof(datum.CrossHM_raw,' '))) : null)", "as": "CrossHM_min"},
    {"calculate": "datum.SunsetHM_raw == null ? null : (indexof(datum.SunsetHM_raw, ':') >= 0 ? toNumber(substring(datum.SunsetHM_raw,0,indexof(datum.SunsetHM_raw,':'))) : null)", "as": "SunsetHM_hour"},
    {"calculate": "datum.SunsetHM_raw == null ? null : (indexof(datum.SunsetHM_raw, ':') >= 0 ? toNumber(substring(datum.SunsetHM_raw,indexof(datum.SunsetHM_raw,':')+1,indexof(datum.SunsetHM_raw,' '))) : null)", "as": "SunsetHM_min"},
    {"calculate": "datum.FirstHM_raw == null ? null : (indexof(datum.FirstHM_raw,'PM') >= 0 || indexof(datum.FirstHM_raw,'pm') >= 0 ? (datum.FirstHM_hour < 12 ? datum.FirstHM_hour + 12 : datum.FirstHM_hour) : (indexof(datum.FirstHM_raw,'AM') >= 0 || indexof(datum.FirstHM_raw,'am') >= 0 ? (datum.FirstHM_hour == 12 ? 0 : datum.FirstHM_hour) : datum.FirstHM_hour))", "as": "FirstHM_hour24"},
    {"calculate": "datum.CrossHM_raw == null ? null : (indexof(datum.CrossHM_raw,'PM') >= 0 || indexof(datum.CrossHM_raw,'pm') >= 0 ? (datum.CrossHM_hour < 12 ? datum.CrossHM_hour + 12 : datum.CrossHM_hour) : (indexof(datum.CrossHM_raw,'AM') >= 0 || indexof(datum.CrossHM_raw,'am') >= 0 ? (datum.CrossHM_hour == 12 ? 0 : datum.CrossHM_hour) : datum.CrossHM_hour))", "as": "CrossHM_hour24"},
    {"calculate": "datum.SunsetHM_raw == null ? null : (indexof(datum.SunsetHM_raw,'PM') >= 0 || indexof(datum.SunsetHM_raw,'pm') >= 0 ? (datum.SunsetHM_hour < 12 ? datum.SunsetHM_hour + 12 : datum.SunsetHM_hour) : (indexof(datum.SunsetHM_raw,'AM') >= 0 || indexof(datum.SunsetHM_raw,'am') >= 0 ? (datum.SunsetHM_hour == 12 ? 0 : datum.SunsetHM_hour) : datum.SunsetHM_hour))", "as": "SunsetHM_hour24"},
    {"calculate": "datum.FirstHM_hour24 == null ? null : (datum.FirstHM_hour24 * 60 + datum.FirstHM_min)", "as": "FirstHM_Minutes"},
    {"calculate": "datum.CrossHM_hour24 == null ? null : (datum.CrossHM_hour24 * 60 + datum.CrossHM_min)", "as": "CrossHM_Minutes"},
    {"calculate": "datum.SunsetHM_hour24 == null ? null : (datum.SunsetHM_hour24 * 60 + datum.SunsetHM_min)", "as": "SunsetMinutes"},
    {"calculate": "datum.FirstHHMM_Minutes != null ? datum.FirstHHMM_Minutes : datum.FirstHM_Minutes", "as": "FirstArrivalMinutes"},
    {"calculate": "datum.CrossHHMM_Minutes != null ? datum.CrossHHMM_Minutes : datum.CrossHM_Minutes", "as": "FirstCrossMinutes"},
    {"calculate": "arrivalChoice == 'First' ? datum.FirstArrivalMinutes : datum.FirstCrossMinutes", "as": "ArrivalMinutes_selected"},
    {"calculate": "arrivalChoice == 'First' ? datum.FirstHM_raw : datum.CrossHM_raw", "as": "ArrivalHM_selected"},
    {"filter": "datum.ArrivalMinutes_selected != null"},
    {
      "calculate": "datum.Date_parsed >= datetime(2018, 9, 7) && datum.Date_parsed <= datetime(2019, 3, 7) ? 1 : 0",
      "as": "isDST"
    },
    {
      "calculate": "datum.ArrivalMinutes_selected - (datum.isDST == 1 ? 60 : 0)",
      "as": "ArrivalMinutes_adjusted"
    },
    {
      "calculate": "datetime(2000, 0, 1, floor(datum.ArrivalMinutes_adjusted / 60), datum.ArrivalMinutes_adjusted % 60, 0)",
      "as": "ArrivalTime_adjusted"
    },
    {
      "calculate": "datum.SunsetMinutes == null ? null : datetime(2000, 0, 1, floor(datum.SunsetMinutes / 60), datum.SunsetMinutes % 60, 0)",
      "as": "SunsetTime_original"
    },
    {
      "window": [{"op": "mean", "field": "ArrivalMinutes_adjusted", "as": "RollingAvgMinutes_adjusted"}],
      "sort": [{"field": "Date_parsed", "order": "ascending"}],
      "frame": [-2, 2]
    },
    {
      "calculate": "datetime(2000, 0, 1, floor(datum.RollingAvgMinutes_adjusted / 60), datum.RollingAvgMinutes_adjusted % 60, 0)",
      "as": "RollingAvgTime_adjusted"
    }
  ],
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "size": 120},
      "encoding": {
        "x": {
          "field": "Date_parsed",
          "type": "temporal",
          "title": "Date",
          "axis": {"format": "%b", "labelAngle": 0, "tickCount": "month"}
        },
        "y": {
          "field": "ArrivalTime_adjusted",
          "type": "temporal",
          "title": "Arrival time (AEST baseline)",
          "axis": {"format": "%H:%M"}
        },
        "color": {
          "field": "CloudCoverNum",
          "type": "quantitative",
          "title": "Cloud Cover (%)",
          "scale": {"scheme": "blues", "reverse": true},
          "legend": {"title": "Cloud Cover (%)", "orient": "right", "offset": 10}
        },
        "tooltip": [
          {"field": "Date", "type": "nominal"},
          {"field": "ArrivalHM_selected", "type": "nominal", "title": "Arrival (original)"},
          {"field": "ArrivalTime_adjusted", "type": "temporal", "title": "Arrival (AEST baseline)"},
          {"field": "sunset_time", "type": "nominal", "title": "Sunset (original)"},
          {"field": "SunsetTime_original", "type": "temporal", "title": "Sunset (original plotted)"},
          {"field": "isDST", "type": "quantitative", "title": "DST flag (1 = DST)"},
          {"field": "CloudCoverNum", "type": "quantitative", "title": "Cloud Cover (%)"}
        ]
      }
    },
    {
      "transform": [{"calculate": "'Rolling average'", "as": "series"}],
      "mark": {"type": "line", "strokeWidth": 3},
      "encoding": {
        "x": {"field": "Date_parsed", "type": "temporal"},
        "y": {"field": "RollingAvgTime_adjusted", "type": "temporal"},
        "stroke": {
          "field": "series",
          "type": "nominal",
          "scale": {"domain": ["Rolling average", "Sunset"], "range": ["#d62728", "black"]},
          "legend": {"title": "Series", "orient": "right", "offset": 10}
        }
      }
    },
    {
      "transform": [{"calculate": "'Sunset'", "as": "series"}],
      "mark": {"type": "line", "strokeWidth": 2, "strokeDash": [6, 4]},
      "encoding": {
        "x": {"field": "Date_parsed", "type": "temporal"},
        "y": {"field": "SunsetTime_original", "type": "temporal"},
        "stroke": {
          "field": "series",
          "type": "nominal",
          "scale": {"domain": ["Rolling average", "Sunset"], "range": ["#d62728", "black"]},
          "legend": {"title": "Series", "orient": "right", "offset": 10}
        }
      }
    }
  ],
  "config": {
    "axis": {"labelFontSize": 12, "titleFontSize": 13},
    "legend": {"titleFontSize": 12, "labelFontSize": 11}
  }
}
