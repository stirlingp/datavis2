{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#f7f3ea",
  "title": {
    "text": "Cloud Cover and Night-Sky Visibility",
    "subtitle": "Globe at Night observations grouped by reported cloud cover and limiting magnitude",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "color": "#243b35",
    "subtitleColor": "#5b625e"
  },
  "width": 780,
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/GaN2025.json",
    "format": {
      "type": "json"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.LimitingMag)",
      "as": "limiting_mag"
    },
    {
      "filter": "datum.limiting_mag >= 0 && datum.limiting_mag <= 7"
    },
    {
      "filter": "datum.CloudCover != null && datum.CloudCover != ''"
    },
    {
      "calculate": "datum.CloudCover == 'clear' ? 1 : datum.CloudCover == '1/4 of sky' ? 2 : datum.CloudCover == '1/2 of sky' ? 3 : datum.CloudCover == 'over 1/2 of sky' ? 4 : 5",
      "as": "cloud_order"
    },
    {
      "calculate": "datum.limiting_mag <= 2 ? 'Very poor visibility' : datum.limiting_mag <= 4 ? 'Poor visibility' : datum.limiting_mag <= 5 ? 'Moderate visibility' : datum.limiting_mag <= 6 ? 'Good visibility' : 'Excellent visibility'",
      "as": "visibility_level"
    }
  ],
  "mark": {
    "type": "rect"
  },
  "encoding": {
    "x": {
      "field": "limiting_mag",
      "type": "ordinal",
      "title": "Limiting magnitude",
      "sort": [0, 1, 2, 3, 4, 5, 6, 7]
    },
    "y": {
      "field": "CloudCover",
      "type": "nominal",
      "title": "Cloud cover",
      "sort": {
        "field": "cloud_order",
        "order": "ascending"
      }
    },
    "color": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Observations",
      "scale": {
        "scheme": "yellowgreenblue"
      }
    },
    "tooltip": [
      {
        "field": "CloudCover",
        "type": "nominal",
        "title": "Cloud cover"
      },
      {
        "field": "limiting_mag",
        "type": "ordinal",
        "title": "Limiting magnitude"
      },
      {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Observations"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#ddd6c8",
      "domainColor": "#9d9588",
      "tickColor": "#9d9588",
      "labelColor": "#333333",
      "titleColor": "#333333",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
