{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "transparent",
  "description": "Cloud cover compared with limiting magnitude observations",
  "width": 760,
  "height": 360,
  "padding": {
    "left": 10,
    "right": 20,
    "top": 10,
    "bottom": 10
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/GaN2025.json",
    "format": {
      "type": "json"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.LimitingMag)",
      "as": "limiting_mag"
    },
    {
      "filter": "isValid(datum.limiting_mag) && isFinite(datum.limiting_mag)"
    },
    {
      "filter": "datum.limiting_mag >= 0 && datum.limiting_mag <= 7"
    },
    {
      "filter": "datum.CloudCover != null && datum.CloudCover != ''"
    },
    {
      "calculate": "datum.CloudCover == 'clear' ? 1 : datum.CloudCover == '1/4 of sky' ? 2 : datum.CloudCover == '1/2 of sky' ? 3 : datum.CloudCover == 'over 1/2 of sky' ? 4 : 5",
      "as": "cloud_order"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#2c2d33",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "limiting_mag",
      "type": "ordinal",
      "title": "Limiting magnitude",
      "sort": [0, 1, 2, 3, 4, 5, 6, 7],
      "axis": {
        "labelAngle": 0,
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84"
      }
    },
    "y": {
      "field": "CloudCover",
      "type": "nominal",
      "title": "Cloud cover",
      "sort": {
        "field": "cloud_order",
        "order": "ascending"
      },
      "axis": {
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84",
        "labelLimit": 160
      }
    },
    "color": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Observations",
      "scale": {
        "scheme": "viridis"
      },
      "legend": {
        "orient": "right",
        "titleColor": "#eeeeee",
        "labelColor": "#dddddd",
        "titleFontSize": 11,
        "labelFontSize": 10,
        "gradientLength": 180
      }
    },
    "tooltip": [
      {
        "field": "CloudCover",
        "type": "nominal",
        "title": "Cloud cover"
      },
      {
        "field": "limiting_mag",
        "type": "ordinal",
        "title": "Limiting magnitude"
      },
      {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Observations"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "grid": false
    },
    "legend": {
      "titleColor": "#eeeeee",
      "labelColor": "#dddddd"
    }
  }
}
