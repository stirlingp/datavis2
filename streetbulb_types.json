{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "transparent",
  "description": "Streetlights grouped by bulb technology category",
  "width": 760,
  "height": 360,
  "padding": {
    "left": 10,
    "right": 25,
    "top": 10,
    "bottom": 10
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/streetlight_type_grid_small.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.streetlight_count)",
      "as": "count"
    },
    {
      "filter": "isValid(datum.count) && isFinite(datum.count)"
    },
    {
      "filter": "datum.bulb_type != null && datum.bulb_type != '' && datum.bulb_type != 'Unknown'"
    },
    {
      "calculate": "lower(datum.bulb_type)",
      "as": "bulb_lower"
    },
    {
      "calculate": "indexof(datum.bulb_lower, 'light-emitting diode') >= 0 || indexof(datum.bulb_lower, 'led') >= 0 ? 'LED' : indexof(datum.bulb_lower, 'mercury') >= 0 || indexof(datum.bulb_lower, 'fluorescent') >= 0 ? 'Mercury / Fluorescent' : indexof(datum.bulb_lower, 'sodium') >= 0 ? 'Sodium' : 'Other'",
      "as": "light_category"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "total_lights"
        }
      ],
      "groupby": [
        "light_category"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "total_lights",
          "as": "all_lights"
        }
      ]
    },
    {
      "calculate": "datum.total_lights / datum.all_lights * 100",
      "as": "percent"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 7,
    "opacity": 0.95
  },
  "encoding": {
    "y": {
      "field": "light_category",
      "type": "nominal",
      "title": null,
      "sort": [
        "LED",
        "Sodium",
        "Mercury / Fluorescent",
        "Other"
      ],
      "axis": {
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84",
        "labelLimit": 220
      }
    },
    "x": {
      "field": "total_lights",
      "type": "quantitative",
      "title": "Number of streetlights",
      "axis": {
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84",
        "gridColor": "#3f424a",
        "format": ","
      }
    },
    "color": {
      "field": "light_category",
      "type": "nominal",
      "title": "Lighting category",
      "scale": {
        "domain": [
          "LED",
          "Sodium",
          "Mercury / Fluorescent",
          "Other"
        ],
        "range": [
          "#2a9d8f",
          "#e9c46a",
          "#e76f51",
          "#577590"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "light_category",
        "type": "nominal",
        "title": "Lighting category"
      },
      {
        "field": "total_lights",
        "type": "quantitative",
        "title": "Streetlights",
        "format": ","
      },
      {
        "field": "percent",
        "type": "quantitative",
        "title": "Share of total",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
