{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "transparent",
  "description": "Approximate visible stars by limiting magnitude",
  "width": 760,
  "height": 390,
  "padding": {
    "left": 10,
    "right": 20,
    "top": 10,
    "bottom": 10
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/GaN2025.json",
    "format": {
      "type": "json"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.LimitingMag)",
      "as": "limiting_mag"
    },
    {
      "filter": "isValid(datum.limiting_mag) && isFinite(datum.limiting_mag)"
    },
    {
      "filter": "datum.limiting_mag >= 0 && datum.limiting_mag <= 7"
    },
    {
      "calculate": "datum.limiting_mag <= 0 ? 5 : datum.limiting_mag == 1 ? 15 : datum.limiting_mag == 2 ? 48 : datum.limiting_mag == 3 ? 171 : datum.limiting_mag == 4 ? 513 : datum.limiting_mag == 5 ? 1600 : datum.limiting_mag == 6 ? 4800 : 14000",
      "as": "approx_visible_stars"
    },
    {
      "calculate": "datum.limiting_mag <= 2 ? 'Very poor visibility' : datum.limiting_mag <= 4 ? 'Poor visibility' : datum.limiting_mag <= 5 ? 'Moderate visibility' : datum.limiting_mag <= 6 ? 'Good visibility' : 'Excellent visibility'",
      "as": "visibility_level"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "observations"
        },
        {
          "op": "mean",
          "field": "approx_visible_stars",
          "as": "mean_visible_stars"
        }
      ],
      "groupby": [
        "limiting_mag",
        "visibility_level"
      ]
    }
  ],
  "mark": {
    "type": "circle",
    "filled": true,
    "opacity": 0.88,
    "stroke": "#111217",
    "strokeWidth": 0.6
  },
  "encoding": {
    "x": {
      "field": "limiting_mag",
      "type": "ordinal",
      "title": "Limiting magnitude",
      "sort": [0, 1, 2, 3, 4, 5, 6, 7],
      "axis": {
        "labelAngle": 0,
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84",
        "grid": false
      }
    },
    "y": {
      "field": "mean_visible_stars",
      "type": "quantitative",
      "title": "Approximate visible stars",
      "scale": {
        "type": "sqrt",
        "zero": true
      },
      "axis": {
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84",
        "gridColor": "#3f424a",
        "format": ","
      }
    },
    "size": {
      "field": "observations",
      "type": "quantitative",
      "title": "Observations",
      "scale": {
        "range": [120, 2400]
      },
      "legend": {
        "orient": "right",
        "titleColor": "#eeeeee",
        "labelColor": "#dddddd",
        "titleFontSize": 11,
        "labelFontSize": 10
      }
    },
    "color": {
      "field": "visibility_level",
      "type": "nominal",
      "title": "Visibility level",
      "scale": {
        "domain": [
          "Very poor visibility",
          "Poor visibility",
          "Moderate visibility",
          "Good visibility",
          "Excellent visibility"
        ],
        "range": [
          "#e76f51",
          "#f4a261",
          "#e9c46a",
          "#2a9d8f",
          "#577590"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titleColor": "#eeeeee",
        "labelColor": "#dddddd",
        "titleFontSize": 11,
        "labelFontSize": 10,
        "columns": 3
      }
    },
    "tooltip": [
      {
        "field": "limiting_mag",
        "type": "ordinal",
        "title": "Limiting magnitude"
      },
      {
        "field": "visibility_level",
        "type": "nominal",
        "title": "Visibility level"
      },
      {
        "field": "mean_visible_stars",
        "type": "quantitative",
        "title": "Approx. visible stars",
        "format": ",.0f"
      },
      {
        "field": "observations",
        "type": "quantitative",
        "title": "Observations",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "titleColor": "#eeeeee",
      "labelColor": "#dddddd"
    }
  }
}
