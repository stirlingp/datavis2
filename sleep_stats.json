{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#f7f3ea",
  "title": {
    "text": "Sleep Timing Differences Between Major Cities and Regional Australia",
    "subtitle": "Dumbbell chart comparing sleep and wake times across age groups",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "color": "#243b35",
    "subtitleColor": "#5b625e"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/sleep_stats.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "fold": [
        "Weeknights",
        "Weekend nights",
        "All nights",
        "Weekdays",
        "Weekend days",
        "All days"
      ],
      "as": ["period", "time_label"]
    },
    {
      "filter": "datum.region != null && datum.region != ''"
    },
    {
      "filter": "datum.age_group != null && datum.age_group != ''"
    },
    {
      "filter": "datum.time_label != null && datum.time_label != ''"
    },
    {
      "calculate": "trim(datum.time_label)",
      "as": "time_clean"
    },
    {
      "calculate": "toNumber(substring(datum.time_clean, 0, indexof(datum.time_clean, ':')))",
      "as": "hour_raw"
    },
    {
      "calculate": "toNumber(substring(datum.time_clean, indexof(datum.time_clean, ':') + 1, indexof(datum.time_clean, ' ')))",
      "as": "minute_raw"
    },
    {
      "calculate": "indexof(lower(datum.time_clean), 'pm') >= 0 && datum.hour_raw < 12 ? datum.hour_raw + 12 : indexof(lower(datum.time_clean), 'am') >= 0 && datum.hour_raw == 12 ? 0 : datum.hour_raw",
      "as": "hour_24"
    },
    {
      "calculate": "datum.hour_24 * 60 + datum.minute_raw",
      "as": "minutes"
    },
    {
      "calculate": "datum.period == 'Weeknights' || datum.period == 'Weekend nights' || datum.period == 'All nights' ? 'Bedtime' : 'Wake time'",
      "as": "chart"
    },
    {
      "filter": "isValid(datum.minutes) && isFinite(datum.minutes)"
    }
  ],
  "vconcat": [
    {
      "title": {
        "text": "Bedtime",
        "anchor": "start",
        "fontSize": 16,
        "color": "#243b35"
      },
      "transform": [
        {
          "filter": "datum.chart == 'Bedtime'"
        }
      ],
      "facet": {
        "column": {
          "field": "period",
          "type": "nominal",
          "sort": ["Weeknights", "Weekend nights", "All nights"],
          "header": {
            "title": null,
            "labelFontSize": 13,
            "labelColor": "#243b35"
          }
        }
      },
      "spec": {
        "width": 220,
        "height": 180,
        "layer": [
          {
            "mark": {
              "type": "rule",
              "strokeWidth": 3,
              "color": "#b8b0a3"
            },
            "encoding": {
              "y": {
                "field": "age_group",
                "type": "nominal",
                "sort": ["5 - 17 years old", "18-64", "65+"],
                "title": "Age group"
              },
              "x": {
                "aggregate": "min",
                "field": "minutes",
                "type": "quantitative",
                "title": "Time",
                "scale": {
                  "domain": [1320, 1440]
                },
                "axis": {
                  "values": [1320, 1350, 1380, 1410, 1440],
                  "labelExpr": "timeFormat(datetime(2000,0,1,floor(datum.value/60),datum.value % 60), '%I:%M %p')"
                }
              },
              "x2": {
                "aggregate": "max",
                "field": "minutes"
              },
              "detail": {
                "field": "age_group"
              }
            }
          },
          {
            "mark": {
              "type": "point",
              "filled": true,
              "size": 120,
              "opacity": 0.95
            },
            "encoding": {
              "y": {
                "field": "age_group",
                "type": "nominal",
                "sort": ["5 - 17 years old", "18-64", "65+"],
                "title": "Age group"
              },
              "x": {
                "field": "minutes",
                "type": "quantitative",
                "scale": {
                  "domain": [1320, 1440]
                },
                "axis": {
                  "values": [1320, 1350, 1380, 1410, 1440],
                  "labelExpr": "timeFormat(datetime(2000,0,1,floor(datum.value/60),datum.value % 60), '%I:%M %p')"
                }
              },
              "color": {
                "field": "region",
                "type": "nominal",
                "title": "Region",
                "scale": {
                  "domain": [
                    "Major Cities",
                    "Regional and Remote"
                  ],
                  "range": [
                    "#e76f51",
                    "#2a9d8f"
                  ]
                }
              },
              "tooltip": [
                {
                  "field": "period",
                  "type": "nominal",
                  "title": "Period"
                },
                {
                  "field": "age_group",
                  "type": "nominal",
                  "title": "Age group"
                },
                {
                  "field": "region",
                  "type": "nominal",
                  "title": "Region"
                },
                {
                  "field": "time_clean",
                  "type": "nominal",
                  "title": "Time"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "title": {
        "text": "Wake Time",
        "anchor": "start",
        "fontSize": 16,
        "color": "#243b35"
      },
      "transform": [
        {
          "filter": "datum.chart == 'Wake time'"
        }
      ],
      "facet": {
        "column": {
          "field": "period",
          "type": "nominal",
          "sort": ["Weekdays", "Weekend days", "All days"],
          "header": {
            "title": null,
            "labelFontSize": 13,
            "labelColor": "#243b35"
          }
        }
      },
      "spec": {
        "width": 220,
        "height": 180,
        "layer": [
          {
            "mark": {
              "type": "rule",
              "strokeWidth": 3,
              "color": "#b8b0a3"
            },
            "encoding": {
              "y": {
                "field": "age_group",
                "type": "nominal",
                "sort": ["5 - 17 years old", "18-64", "65+"],
                "title": "Age group"
              },
              "x": {
                "aggregate": "min",
                "field": "minutes",
                "type": "quantitative",
                "title": "Time",
                "scale": {
                  "domain": [380, 460]
                },
                "axis": {
                  "values": [390, 420, 450],
                  "labelExpr": "timeFormat(datetime(2000,0,1,floor(datum.value/60),datum.value % 60), '%I:%M %p')"
                }
              },
              "x2": {
                "aggregate": "max",
                "field": "minutes"
              },
              "detail": {
                "field": "age_group"
              }
            }
          },
          {
            "mark": {
              "type": "point",
              "filled": true,
              "size": 120,
              "opacity": 0.95
            },
            "encoding": {
              "y": {
                "field": "age_group",
                "type": "nominal",
                "sort": ["5 - 17 years old", "18-64", "65+"],
                "title": "Age group"
              },
              "x": {
                "field": "minutes",
                "type": "quantitative",
                "scale": {
                  "domain": [380, 460]
                },
                "axis": {
                  "values": [390, 420, 450],
                  "labelExpr": "timeFormat(datetime(2000,0,1,floor(datum.value/60),datum.value % 60), '%I:%M %p')"
                }
              },
              "color": {
                "field": "region",
                "type": "nominal",
                "title": "Region",
                "scale": {
                  "domain": [
                    "Major Cities",
                    "Regional and Remote"
                  ],
                  "range": [
                    "#e76f51",
                    "#2a9d8f"
                  ]
                }
              },
              "tooltip": [
                {
                  "field": "period",
                  "type": "nominal",
                  "title": "Period"
                },
                {
                  "field": "age_group",
                  "type": "nominal",
                  "title": "Age group"
                },
                {
                  "field": "region",
                  "type": "nominal",
                  "title": "Region"
                },
                {
                  "field": "time_clean",
                  "type": "nominal",
                  "title": "Time"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#ddd6c8",
      "domainColor": "#9d9588",
      "tickColor": "#9d9588",
      "labelColor": "#333333",
      "titleColor": "#333333",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
