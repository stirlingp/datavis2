{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "transparent",
  "description": "Sleep timing differences between Major Cities and Regional and Remote Australia",
  "width": 980,
  "height": 620,
  "padding": {
    "left": 10,
    "right": 35,
    "top": 10,
    "bottom": 20
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/sleep_stats.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "fold": [
        "Weeknights",
        "Weekend nights",
        "All nights",
        "Weekdays",
        "Weekend days",
        "All days"
      ],
      "as": ["period", "time_label"]
    },
    {
      "filter": "datum.region != null && datum.region != ''"
    },
    {
      "filter": "datum.age_group != null && datum.age_group != ''"
    },
    {
      "filter": "datum.time_label != null && datum.time_label != ''"
    },
    {
      "calculate": "trim(datum.time_label)",
      "as": "time_clean"
    },
    {
      "calculate": "toNumber(substring(datum.time_clean, 0, indexof(datum.time_clean, ':')))",
      "as": "hour_raw"
    },
    {
      "calculate": "toNumber(substring(datum.time_clean, indexof(datum.time_clean, ':') + 1, indexof(datum.time_clean, ' ')))",
      "as": "minute_raw"
    },
    {
      "calculate": "indexof(lower(datum.time_clean), 'pm') >= 0 && datum.hour_raw < 12 ? datum.hour_raw + 12 : indexof(lower(datum.time_clean), 'am') >= 0 && datum.hour_raw == 12 ? 0 : datum.hour_raw",
      "as": "hour_24"
    },
    {
      "calculate": "datum.hour_24 * 60 + datum.minute_raw",
      "as": "minutes"
    },
    {
      "calculate": "datum.period == 'Weeknights' || datum.period == 'Weekend nights' || datum.period == 'All nights' ? 'Bedtime' : 'Wake time'",
      "as": "chart"
    },
    {
      "filter": "isValid(datum.minutes) && isFinite(datum.minutes)"
    }
  ],
  "vconcat": [
    {
      "title": {
        "text": "Bedtime",
        "anchor": "start",
        "fontSize": 15,
        "color": "#eeeeee"
      },
      "transform": [
        {
          "filter": "datum.chart == 'Bedtime'"
        }
      ],
      "facet": {
        "column": {
          "field": "period",
          "type": "nominal",
          "sort": ["Weeknights", "Weekend nights", "All nights"],
          "header": {
            "title": null,
            "labelFontSize": 12,
            "labelColor": "#eeeeee"
          }
        }
      },
      "spec": {
        "width": 280,
        "height": 210,
        "layer": [
          {
            "mark": {
              "type": "rule",
              "strokeWidth": 3,
              "color": "#777a84"
            },
            "encoding": {
              "y": {
                "field": "age_group",
                "type": "nominal",
                "sort": ["5 - 17 years old", "18-64", "65+"],
                "title": "Age group",
                "axis": {
                  "labelColor": "#dddddd",
                  "titleColor": "#eeeeee",
                  "domainColor": "#777a84",
                  "tickColor": "#777a84"
                }
              },
              "x": {
                "aggregate": "min",
                "field": "minutes",
                "type": "quantitative",
                "title": "Time",
                "scale": {
                  "domain": [1320, 1440]
                },
                "axis": {
                  "values": [1320, 1350, 1380, 1410, 1440],
                  "labelExpr": "timeFormat(datetime(2000,0,1,floor(datum.value/60),datum.value % 60), '%I:%M %p')",
                  "labelColor": "#dddddd",
                  "titleColor": "#eeeeee",
                  "domainColor": "#777a84",
                  "tickColor": "#777a84",
                  "gridColor": "#3f424a"
                }
              },
              "x2": {
                "aggregate": "max",
                "field": "minutes"
              },
              "detail": {
                "field": "age_group"
              }
            }
          },
          {
            "mark": {
              "type": "point",
              "filled": true,
              "size": 115,
              "opacity": 0.95,
              "stroke": "#111217",
              "strokeWidth": 0.5
            },
            "encoding": {
              "y": {
                "field": "age_group",
                "type": "nominal",
                "sort": ["5 - 17 years old", "18-64", "65+"],
                "title": "Age group",
                "axis": {
                  "labelColor": "#dddddd",
                  "titleColor": "#eeeeee",
                  "domainColor": "#777a84",
                  "tickColor": "#777a84"
                }
              },
              "x": {
                "field": "minutes",
                "type": "quantitative",
                "scale": {
                  "domain": [1320, 1440]
                },
                "axis": {
                  "values": [1320, 1350, 1380, 1410, 1440],
                  "labelExpr": "timeFormat(datetime(2000,0,1,floor(datum.value/60),datum.value % 60), '%I:%M %p')",
                  "labelColor": "#dddddd",
                  "titleColor": "#eeeeee",
                  "domainColor": "#777a84",
                  "tickColor": "#777a84",
                  "gridColor": "#3f424a"
                }
              },
              "color": {
                "field": "region",
                "type": "nominal",
                "title": "Region",
                "scale": {
                  "domain": [
                    "Major Cities",
                    "Regional and Remote"
                  ],
                  "range": [
                    "#e76f51",
                    "#2a9d8f"
                  ]
                },
                "legend": {
                  "orient": "bottom",
                  "direction": "horizontal",
                  "titleColor": "#eeeeee",
                  "labelColor": "#dddddd",
                  "titleFontSize": 11,
                  "labelFontSize": 10
                }
              },
              "tooltip": [
                {
                  "field": "period",
                  "type": "nominal",
                  "title": "Period"
                },
                {
                  "field": "age_group",
                  "type": "nominal",
                  "title": "Age group"
                },
                {
                  "field": "region",
                  "type": "nominal",
                  "title": "Region"
                },
                {
                  "field": "time_clean",
                  "type": "nominal",
                  "title": "Time"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "title": {
        "text": "Wake time",
        "anchor": "start",
        "fontSize": 15,
        "color": "#eeeeee"
      },
      "transform": [
        {
          "filter": "datum.chart == 'Wake time'"
        }
      ],
      "facet": {
        "column": {
          "field": "period",
          "type": "nominal",
          "sort": ["Weekdays", "Weekend days", "All days"],
          "header": {
            "title": null,
            "labelFontSize": 12,
            "labelColor": "#eeeeee"
          }
        }
      },
      "spec": {
        "width": 280,
        "height": 210,
        "layer": [
          {
            "mark": {
              "type": "rule",
              "strokeWidth": 3,
              "color": "#777a84"
            },
            "encoding": {
              "y": {
                "field": "age_group",
                "type": "nominal",
                "sort": ["5 - 17 years old", "18-64", "65+"],
                "title": "Age group",
                "axis": {
                  "labelColor": "#dddddd",
                  "titleColor": "#eeeeee",
                  "domainColor": "#777a84",
                  "tickColor": "#777a84"
                }
              },
              "x": {
                "aggregate": "min",
                "field": "minutes",
                "type": "quantitative",
                "title": "Time",
                "scale": {
                  "domain": [380, 460]
                },
                "axis": {
                  "values": [390, 420, 450],
                  "labelExpr": "timeFormat(datetime(2000,0,1,floor(datum.value/60),datum.value % 60), '%I:%M %p')",
                  "labelColor": "#dddddd",
                  "titleColor": "#eeeeee",
                  "domainColor": "#777a84",
                  "tickColor": "#777a84",
                  "gridColor": "#3f424a"
                }
              },
              "x2": {
                "aggregate": "max",
                "field": "minutes"
              },
              "detail": {
                "field": "age_group"
              }
            }
          },
          {
            "mark": {
              "type": "point",
              "filled": true,
              "size": 115,
              "opacity": 0.95,
              "stroke": "#111217",
              "strokeWidth": 0.5
            },
            "encoding": {
              "y": {
                "field": "age_group",
                "type": "nominal",
                "sort": ["5 - 17 years old", "18-64", "65+"],
                "title": "Age group",
                "axis": {
                  "labelColor": "#dddddd",
                  "titleColor": "#eeeeee",
                  "domainColor": "#777a84",
                  "tickColor": "#777a84"
                }
              },
              "x": {
                "field": "minutes",
                "type": "quantitative",
                "scale": {
                  "domain": [380, 460]
                },
                "axis": {
                  "values": [390, 420, 450],
                  "labelExpr": "timeFormat(datetime(2000,0,1,floor(datum.value/60),datum.value % 60), '%I:%M %p')",
                  "labelColor": "#dddddd",
                  "titleColor": "#eeeeee",
                  "domainColor": "#777a84",
                  "tickColor": "#777a84",
                  "gridColor": "#3f424a"
                }
              },
              "color": {
                "field": "region",
                "type": "nominal",
                "title": "Region",
                "scale": {
                  "domain": [
                    "Major Cities",
                    "Regional and Remote"
                  ],
                  "range": [
                    "#e76f51",
                    "#2a9d8f"
                  ]
                },
                "legend": {
                  "orient": "bottom",
                  "direction": "horizontal",
                  "titleColor": "#eeeeee",
                  "labelColor": "#dddddd",
                  "titleFontSize": 11,
                  "labelFontSize": 10
                }
              },
              "tooltip": [
                {
                  "field": "period",
                  "type": "nominal",
                  "title": "Period"
                },
                {
                  "field": "age_group",
                  "type": "nominal",
                  "title": "Age group"
                },
                {
                  "field": "region",
                  "type": "nominal",
                  "title": "Region"
                },
                {
                  "field": "time_clean",
                  "type": "nominal",
                  "title": "Time"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "titleColor": "#eeeeee",
      "labelColor": "#dddddd"
    }
  }
}
