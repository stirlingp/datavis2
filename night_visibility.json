{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "transparent",
  "description": "Distribution of Globe at Night observations by limiting magnitude",
  "width": 760,
  "height": 360,
  "padding": {
    "left": 10,
    "right": 20,
    "top": 10,
    "bottom": 10
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/GaN2025.json",
    "format": {
      "type": "json"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.LimitingMag)",
      "as": "limiting_mag"
    },
    {
      "filter": "isValid(datum.limiting_mag) && isFinite(datum.limiting_mag)"
    },
    {
      "filter": "datum.limiting_mag >= 0 && datum.limiting_mag <= 7"
    },
    {
      "calculate": "datum.limiting_mag <= 2 ? 'Very poor visibility' : datum.limiting_mag <= 4 ? 'Poor visibility' : datum.limiting_mag <= 5 ? 'Moderate visibility' : datum.limiting_mag <= 6 ? 'Good visibility' : 'Excellent visibility'",
      "as": "visibility_level"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 5,
    "opacity": 0.95
  },
  "encoding": {
    "x": {
      "field": "limiting_mag",
      "type": "ordinal",
      "title": "Limiting magnitude",
      "sort": [0, 1, 2, 3, 4, 5, 6, 7],
      "axis": {
        "labelAngle": 0,
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84",
        "grid": false
      }
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of observations",
      "axis": {
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84",
        "gridColor": "#3f424a"
      }
    },
    "color": {
      "field": "visibility_level",
      "type": "nominal",
      "title": "Visibility level",
      "scale": {
        "domain": [
          "Very poor visibility",
          "Poor visibility",
          "Moderate visibility",
          "Good visibility",
          "Excellent visibility"
        ],
        "range": [
          "#e76f51",
          "#f4a261",
          "#e9c46a",
          "#2a9d8f",
          "#577590"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titleColor": "#eeeeee",
        "labelColor": "#dddddd",
        "titleFontSize": 11,
        "labelFontSize": 10,
        "columns": 3
      }
    },
    "tooltip": [
      {
        "field": "limiting_mag",
        "type": "ordinal",
        "title": "Limiting magnitude"
      },
      {
        "field": "visibility_level",
        "type": "nominal",
        "title": "Visibility level"
      },
      {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Observations"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "titleColor": "#eeeeee",
      "labelColor": "#dddddd"
    }
  }
}
