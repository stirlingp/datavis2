{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "transparent",
  "description": "Streetlight technology composition across wattage bands",
  "width": 760,
  "height": 370,
  "padding": {
    "left": 10,
    "right": 25,
    "top": 10,
    "bottom": 10
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/stirlingp/datavis2/main/streetlight_type_grid_small.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.streetlight_count)",
      "as": "count"
    },
    {
      "calculate": "toNumber(datum.avg_bulb_watts)",
      "as": "watts"
    },
    {
      "filter": "isValid(datum.count) && isFinite(datum.count)"
    },
    {
      "filter": "isValid(datum.watts) && isFinite(datum.watts)"
    },
    {
      "filter": "datum.bulb_type != null && datum.bulb_type != '' && datum.bulb_type != 'Unknown'"
    },
    {
      "calculate": "lower(datum.bulb_type)",
      "as": "bulb_lower"
    },
    {
      "calculate": "indexof(datum.bulb_lower, 'light-emitting diode') >= 0 || indexof(datum.bulb_lower, 'led') >= 0 ? 'LED' : indexof(datum.bulb_lower, 'mercury') >= 0 || indexof(datum.bulb_lower, 'fluorescent') >= 0 ? 'Mercury / Fluorescent' : indexof(datum.bulb_lower, 'sodium') >= 0 ? 'Sodium' : 'Other'",
      "as": "light_category"
    },
    {
      "calculate": "datum.watts < 40 ? 'Low wattage (<40W)' : datum.watts < 80 ? 'Medium wattage (40–79W)' : datum.watts < 150 ? 'High wattage (80–149W)' : 'Very high wattage (150W+)'",
      "as": "wattage_band"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "total_lights"
        }
      ],
      "groupby": [
        "wattage_band",
        "light_category"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "total_lights",
          "as": "band_total"
        }
      ],
      "groupby": [
        "wattage_band"
      ]
    },
    {
      "calculate": "datum.total_lights / datum.band_total",
      "as": "proportion"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3,
    "opacity": 0.96
  },
  "encoding": {
    "y": {
      "field": "wattage_band",
      "type": "nominal",
      "title": null,
      "sort": [
        "Low wattage (<40W)",
        "Medium wattage (40–79W)",
        "High wattage (80–149W)",
        "Very high wattage (150W+)"
      ],
      "axis": {
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84",
        "labelLimit": 240
      }
    },
    "x": {
      "field": "proportion",
      "type": "quantitative",
      "title": "Share within wattage band",
      "stack": "normalize",
      "axis": {
        "format": ".0%",
        "labelColor": "#dddddd",
        "titleColor": "#eeeeee",
        "domainColor": "#777a84",
        "tickColor": "#777a84",
        "gridColor": "#3f424a"
      }
    },
    "color": {
      "field": "light_category",
      "type": "nominal",
      "title": "Lighting category",
      "scale": {
        "domain": [
          "LED",
          "Sodium",
          "Mercury / Fluorescent",
          "Other"
        ],
        "range": [
          "#2a9d8f",
          "#e9c46a",
          "#e76f51",
          "#577590"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titleColor": "#eeeeee",
        "labelColor": "#dddddd",
        "titleFontSize": 11,
        "labelFontSize": 10
      }
    },
    "tooltip": [
      {
        "field": "wattage_band",
        "type": "nominal",
        "title": "Wattage band"
      },
      {
        "field": "light_category",
        "type": "nominal",
        "title": "Lighting category"
      },
      {
        "field": "total_lights",
        "type": "quantitative",
        "title": "Streetlights",
        "format": ","
      },
      {
        "field": "proportion",
        "type": "quantitative",
        "title": "Share within band",
        "format": ".1%"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "titleColor": "#eeeeee",
      "labelColor": "#dddddd"
    }
  }
}
